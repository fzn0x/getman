# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.10.0.schema.json
PackageIdentifier: fzn0x.Getman
PackageVersion: {{version}}
InstallerType: nullsoft
Scope: user
InstallModes:
  - interactive
  - silent
  - silentWithProgress
InstallerSwitches:
  Silent: /S
  SilentWithProgress: /S
UpgradeBehavior: install
ReleaseDate: {{date}}
Installers:
  - Architecture: x64
    InstallerUrl: {{url:Getman-windows-x64-setup.exe}}
    InstallerSha256: {{SHA256:Getman-windows-x64-setup.exe}}
  - Architecture: arm64
    InstallerUrl: {{url:Getman-windows-arm64-setup.exe}}
    InstallerSha256: {{SHA256:Getman-windows-arm64-setup.exe}}
ManifestType: installer
ManifestVersion: 1.10.0
