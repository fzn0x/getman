{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Getman",
  "identifier": "io.github.fzn0x.getman",
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "fzn0x",
    "homepage": "https://fzn0x.github.io/getman/",
    "license": "MIT OR Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "A local-first API client",
    "longDescription": "Send requests, test APIs and run collections from plain YAML files in your repository. No account, no cloud.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "devel",
        "desktopTemplate": "linux/getman.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/getman.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0NDJFMEUwQjJGMDU2QTUKUldTbFZ2Q3k0T0JDWkM4RXRpWXJwbWR3c3BpVmNHdW95eHUzNklMdmNWTy94bW1SYUN6UUFEOE0K",
      "endpoints": ["https://github.com/fzn0x/getman/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
