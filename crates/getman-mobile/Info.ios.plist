<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app's Info.plist by the Tauri command line. -->
<plist version="1.0">
<dict>
	<!-- The Files app shows the app's documents, where the workspace is,
	     under On My iPhone › Getman, and edits them in place. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- The webview loads the UI from Getman's own server on 127.0.0.1,
	     over plain HTTP that never leaves the phone. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
