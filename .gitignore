# Rust build output
/target/

# Web UI
/web/node_modules/
/web/build/
/web/dist/

# Documentation site
/site/node_modules/
/site/dist/

# Getman's per-workspace local state and machine-only overrides
.getman/
*.local.yaml

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Design-tool workspace: decision pages, review captures and downloaded
# reference images. Not part of the product.
.impeccable/

# Desktop app: the Tauri command line, and the getman command staged for
# the Windows installers (see crates/getman-desktop/windows/)
/crates/getman-desktop/node_modules/
/crates/getman-desktop/windows/bin/

# Claude Code's local state, such as the worktrees its agents work in
.claude/

# Mobile apps: the Tauri command line, and the Xcode project, which the
# iOS builds generate (see .github/workflows/mobile.yml)
/crates/getman-mobile/node_modules/
/crates/getman-mobile/gen/apple/
